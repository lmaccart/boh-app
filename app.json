{
  "expo": {
    "name": "Business of Happiness",
    "slug": "boh-app",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "bohapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebizofhappiness.app"
    },
    "android": {
      "package": "com.thebizofhappiness.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-status-bar"],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
