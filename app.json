{
  "expo": {
    "name": "Business of Happiness",
    "slug": "boh-app",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "bohapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebizofhappiness.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow access to your photos so you can share images and videos in the community.",
        "NSCameraUsageDescription": "Allow access to your camera so you can capture photos and videos to share in the community."
      }
    },
    "android": {
      "package": "com.thebizofhappiness.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-audio",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos so you can share images and videos in the community.",
          "cameraPermission": "Allow access to your camera so you can capture photos and videos to share in the community."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7191C6"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69220649-d47e-43de-8d3c-6db63ec2b16b"
      }
    },
    "owner": "lmaccart"
  }
}
