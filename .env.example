# Supabase connection for the mobile client.
# Copy this file to `.env` and fill in values from your Supabase project
# (Project Settings -> API). Both must be prefixed with EXPO_PUBLIC_ so Expo
# inlines them into the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
